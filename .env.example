# TATTOOGO MK — modelo de ambiente. Copie para `.env` e preencha os valores.
# Nunca commite o `.env` real (ele está no .gitignore).

# ---------------------------------------------------------------------------
# KYC — Prova de identidade (CPF/CNPJ) dos profissionais (tatuador/estúdio)
# ---------------------------------------------------------------------------
# Provedor de identidade: mock (padrão em dev), mercadopago, asaas.
# Em produção, aponte para o provedor real e configure base URL + chave.
KYC_IDENTITY_PROVIDER=mock
KYC_IDENTITY_BASE_URL=
KYC_IDENTITY_API_KEY=

# ---------------------------------------------------------------------------
# KYC — Prova de vida / comparação facial (biometria)
# ---------------------------------------------------------------------------
# Provedor de biometria: mock (padrão em dev), serpro, facematch.
KYC_LIVENESS_PROVIDER=mock
KYC_LIVENESS_BASE_URL=
KYC_LIVENESS_API_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — proteção anti-bot (CAPTCHA invisível)
# ---------------------------------------------------------------------------
# Site key pública (exposta ao browser) usada pelo <TurnstileGuard /> nos
# formulários de login, cadastro e KYC.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key do servidor, usada em /api/kyc/* para validar o token via
# siteverify. Sem esta variável o backend faz fail-open (apenas em dev);
# em produção a ausência é tratada como misconfiguração.
TURNSTILE_SECRET_KEY=
