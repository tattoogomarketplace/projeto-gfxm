# TATTOOGO MK — modelo de ambiente. Copie para `.env` e preencha os valores.
# Nunca commite o `.env` real (ele está no .gitignore).

# ---------------------------------------------------------------------------
# Banco de dados (Neon / Prisma) — PRINCÍPIO DO MENOR PRIVILÉGIO
# ---------------------------------------------------------------------------
# Separação estrita de credenciais. A aplicação em runtime NUNCA deve rodar
# com o papel administrador: DROP/ALTER/TRUNCATE ficam reservados ao CI/CD.
#
# DATABASE_URL  (runtime / app): use o papel RESTRITO `app_runner`.
#   Permissões: apenas SELECT, INSERT, UPDATE, DELETE nas tabelas de negócio.
#   Sem CREATE/ALTER/DROP/TRUNCATE e sem DDL. É a credencial consumida pelo
#   Prisma Client em produção e no preview.
#   Ex.: postgresql://app_runner:SENHA@ep-xxx.aws.neon.tech/neondb?sslmode=require
#
# DIRECT_URL    (migrations / CI/CD): use o papel ADMINISTRADOR do Neon.
#   Passado ao Prisma via `directUrl` no datasource e usado SOMENTE por
#   `npx prisma migrate deploy` / `prisma db push` / `prisma studio`.
#   Nunca deve ser exposto ao runtime da aplicação.
#   Ex.: postgresql://neondb_owner:SENHA@ep-xxx.aws.neon.tech/neondb?sslmode=require
#
# MIGRATION_URL (alias opcional): alguns pipelines injetam a credencial de
#   migração sob este nome. Se usado, aponte DIRECT_URL para o mesmo valor.
#
# Para provisionar o papel restrito, rode o script idempotente:
#   prisma/migrations/20261017_least_privilege_app_runner.sql
DATABASE_URL=postgresql://app_runner:senha_restrita@host.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:senha_admin@host.neon.tech/neondb?sslmode=require
MIGRATION_URL=

# ---------------------------------------------------------------------------
# KYC — Prova de identidade (CPF/CNPJ) dos profissionais (tatuador/estúdio)
# ---------------------------------------------------------------------------
# Provedor de identidade: mock (padrão em dev), mercadopago, asaas.
# Em produção, aponte para o provedor real e configure base URL + chave.
KYC_IDENTITY_PROVIDER=mock
KYC_IDENTITY_BASE_URL=
KYC_IDENTITY_API_KEY=

# ---------------------------------------------------------------------------
# KYC — Prova de vida / comparação facial (biometria)
# ---------------------------------------------------------------------------
# Provedor de biometria: mock (padrão em dev), serpro, facematch.
KYC_LIVENESS_PROVIDER=mock
KYC_LIVENESS_BASE_URL=
KYC_LIVENESS_API_KEY=

# ---------------------------------------------------------------------------
# KYC — Face Matching (segunda etapa biométrica: selfie x documento)
# ---------------------------------------------------------------------------
# Provedor de comparação facial: mock (padrão em dev), aws-rekognition,
# facematch, serpro. Aprovação só com similaridade estritamente superior a 90%.
KYC_FACE_MATCH_PROVIDER=mock
KYC_FACE_MATCH_BASE_URL=
KYC_FACE_MATCH_API_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — proteção anti-bot (CAPTCHA invisível)
# ---------------------------------------------------------------------------
# Site key pública (exposta ao browser) usada pelo <TurnstileGuard /> nos
# formulários de login, cadastro e KYC.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key do servidor, usada em /api/kyc/* (Next.js) e nas rotas Express
# críticas (ex.: POST /api/auth/check-duplicidade) para validar o token via
# siteverify. Sem esta variável o backend faz fail-open (apenas em dev);
# em produção a ausência é tratada como misconfiguração.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# App Attestation — integridade de hardware (Play Integrity / DeviceCheck)
# ---------------------------------------------------------------------------
# Bloqueia requisições com o header X-App-Integrity-Token ausente ou
# explicitamente falsificado em rotas estritas. Sem `APP_INTEGRITY_ENFORCE=true`
# a validação permanece permissiva (apenas observabilidade) — as rotas estritas
# devem declarar `required: true`.
APP_INTEGRITY_ENFORCE=false

# Identidade do app esperada no token atestado.
APP_INTEGRITY_ANDROID_PACKAGE=
APP_INTEGRITY_IOS_BUNDLE_ID=

# Trust anchors (chaves públicas / JWKS) para validar a assinatura do token.
# Injetadas em produção; aceitam URL de JWKS ou JWKS inline em JSON.
APP_INTEGRITY_ANDROID_JWKS_URL=
APP_INTEGRITY_IOS_JWKS_URL=
APP_INTEGRITY_ANDROID_KEYS_JSON=
APP_INTEGRITY_IOS_KEYS_JSON=

# Rejeita tokens atestados mais antigos que N segundos (0 = desativado).
APP_INTEGRITY_MAX_AGE_SECONDS=300

# ---------------------------------------------------------------------------
# Upstash Redis — rate limiting (Edge), mutex de agenda e cache
# ---------------------------------------------------------------------------
# Sem estas variáveis o limiter cai para um sliding window em memória
# (por isolate). Em produção preencha as credenciais REST do Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
