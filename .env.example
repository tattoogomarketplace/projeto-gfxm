# =============================================================================
# TattooGo MK — variáveis consolidadas (Next.js + Express)
# Copie para .env e preencha. Nunca commite o .env real.
# As chaves do Supabase aceitam nomenclatura Next (NEXT_PUBLIC_*) e Express.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=

# --- Banco (Prisma / Express) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tattoogo?schema=public"

# --- Supabase (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (Express) — mesmas credenciais, aliases sem NEXT_PUBLIC_ ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- IA / moderação ---
GEMINI_API_KEY=your-gemini-api-key

# --- Cache / rate-limit (proxy Next + Express) ---
UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Compliance CNPJ (Express) ---
RECEITA_WS_TOKEN=
USE_MOCK_CNPJ=true

# --- Turnstile (produção) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
