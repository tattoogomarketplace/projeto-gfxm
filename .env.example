GEMINI_API_KEY=your-gemini-api-key-here

# Cloudflare R2 (upload direto via URL pré-assinada)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-r2-public-domain.com

# ReceitaWS (validação de CNPJ de estúdios). O token é opcional no plano público.
RECEITA_WS_TOKEN=your-receitaws-token
# Retorna dados sintéticos de CNPJ em desenvolvimento (nunca em produção).
USE_MOCK_CNPJ=false
